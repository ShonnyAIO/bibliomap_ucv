# 1. Configuración de Correo Electrónico (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion

# 2. Configuración del Bot de Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# 3. Configuración de WhatsApp (WAHA Docker Container)
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=bibliomap_secure_key_2026
